# ========== Makers AI 网关（本地调试用） ==========
# 网关 Base URL（Makers Models 固定为此地址）
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
# 模型网关 API Key：从 EdgeOne Makers 控制台 -> 模型与密钥 获取
AI_GATEWAY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 模型 ID（内置免费模型，生产可换为自费/自有厂商模型）
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ========== 高德地图 Web 服务（出行决策 Agent 用） ==========
# 高德开放平台 -> 应用管理 -> 创建应用并添加「Web 服务」Key
AMAP_API_KEY=你的高德地图Key
